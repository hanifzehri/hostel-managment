# =============================================================================
# Royal Hostel Khuzdar Management System - Backend Configuration (.env)
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Persistent MongoDB Database Configuration
# -----------------------------------------------------------------------------
# Option A: MongoDB Atlas Cloud Cluster (Recommended for Production)
# Format 1 (Standard SRV):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_db?retryWrites=true&w=majority
#
# Format 2 (Direct Seed List - Bypasses local DNS SRV restrictions if querySrv ECONNREFUSED occurs):
# MONGODB_URI=mongodb://<username>:<password>@ac-wbzodad-shard-00-00.4s77gl5.mongodb.net:27017,ac-wbzodad-shard-00-01.4s77gl5.mongodb.net:27017,ac-wbzodad-shard-00-02.4s77gl5.mongodb.net:27017/hostel_db?ssl=true&replicaSet=atlas-wbzodad-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Option B: Local MongoDB Service (For offline local development)
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_db

# CRITICAL SECURITY RULE: Never set ALLOW_IN_MEMORY_DB=true in production!
# Must remain false to guarantee persistent storage on MongoDB Atlas / local service.
ALLOW_IN_MEMORY_DB=false

# -----------------------------------------------------------------------------
# Security & JWT Token Authentication
# -----------------------------------------------------------------------------
# Generate a cryptographically secure 64-character secret for production:
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_passphrase_secret
JWT_EXPIRE=7d

# Initial Superadmin / Admin default password on brand new empty database
INITIAL_ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123

# Auto-seed turnkey hostel data on fresh database initialization (true/false)
AUTO_SEED=false

# -----------------------------------------------------------------------------
# CORS & Allowed Frontend Domains
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (local dev + deployed Vercel domain):
FRONTEND_URL=https://hostel-managment-khuzdar.vercel.app,http://localhost:5173,http://localhost:3000
